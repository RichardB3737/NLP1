    "\n",
    "from scipy.sparse import csr_matrix\n",
    "\n",
    "# Original MLP\n",
    "def mlp_predict(texts):\n",
    "    return smlp.predict_probs(\n",
    "        texts,\n",
    "        mlp_model,\n",
    "        token_indicator_encoder\n",
    "    )\n",
    "\n",
    "# Modified MLP\n",
    "def mlp2_predict(texts):\n",
    "    return smlp2.predict_probs2(\n",
    "        texts,\n",
    "        mlp2_model,\n",
    "        token_indicator_encoder\n",
    "    )\n",
    "\n",
    "# Log-linear model\n",
    "def logistic_predict(texts):\n",
    "    # Use Project1's probability function when available\n",
    "    if hasattr(Project1.loglin, \"predict_probs\"):\n",
    "        return Project1.loglin.predict_probs(\n",
    "            texts,\n",
    "            logistic_model,\n",
    "            token_indicator_encoder\n",
    "        )\n",
    "\n",
    "    # Fallback for a fitted scikit-learn logistic model\n",
    "    X = csr_matrix([\n",
    "        token_indicator_encoder(text)\n",
    "        for text in texts\n",
    "    ])\n",
    "\n",
    "    return logistic_model.predict_proba(X)"
   ]
