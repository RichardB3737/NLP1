    "# feature representation\n",
    "\n",
    "class Encoder:\n",
    "\n",
    "    def __len__(self) -> int:\n",
    "        \"\"\"Dimensionality of the representation space\"\"\"\n",
    "        raise NotImplementedError(\"Concrete implementations will be discussed later\")\n",
    "\n",
    "    def __call__(self, x: str) -> 'np.array':\n",
    "        \"\"\"Represent x as a D-dimensional vector of real numbers\"\"\"\n",
    "        raise NotImplementedError(\"Concrete implementations will be discussed later\")\n",
    "\n",
    "class BagOfWords(Encoder):\n",
    "\n",
    "    def __init__(self, tokenizer: Tokenizer):\n",
    "        self.tokenizer = tokenizer\n",
    "\n",
    "    def __len__(self) -> int:\n",
    "        return len(self.tokenizer.get_vocab())\n",
    "\n",
    "    def __call__(self, x: str) -> 'np.array':\n",
    "        vector = np.zeros(len(self))\n",
    "        for token_id in self.tokenizer.encode(x).ids:\n",
    "            vector[token_id] += 1\n",
    "        return vector\n",
    "\n",
    "class TokenIndicator(Encoder):\n",
    "\n",
    "    def __init__(self, tokenizer: Tokenizer):\n",
    "        self.tokenizer = tokenizer\n",
    "        \n",
    "    def __len__(self) -> int:\n",
    "        \"\"\"Dimensionality of the representation space\"\"\"\n",
    "        return len(self.tokenizer.get_vocab())\n",
    "\n",
    "    def __call__(self, x: str) -> 'np.array':\n",
    "        \"\"\"Represent x as a D-dimensional vector of real numbers\"\"\"\n",
    "        unique_token_ids = list(set(self.tokenizer.encode(x).ids))\n",
    "\n",
    "        # A 0 vector with the same length as the vocabulary except in positions corresponding \n",
    "        # to tokens appearing in the document\n",
    "        vector = np.zeros(len(self))\n",
    "        vector[unique_token_ids] = 1\n",
    "        return vector\n",
    "\n",
    "class tfidf(Encoder):\n",
    "\n",
    "    def __init__(self, tokenizer: Tokenizer):\n",
    "        self.tokenizer = tokenizer\n",
    "        self.dataset = dataset['train']\n",
    "        self.idf = self._compute_idf()\n",
    "\n",
    "    def _compute_idf(self) -> 'np.array':\n",
    "        num_documents = len(self.dataset)\n",
    "        df = np.zeros(len(self.tokenizer.get_vocab()))\n",
    "\n",
    "        for example in self.dataset:\n",
    "            unique_token_ids = set(self.tokenizer.encode(example['text']).ids)\n",
    "            for token_id in unique_token_ids:\n",
    "                df[token_id] += 1\n",
    "\n",
    "        idf = np.log((num_documents + 1) / (df + 1)) + 1\n",
    "        return idf\n",
    "\n",
    "    def __len__(self) -> int:\n",
    "        return len(self.tokenizer.get_vocab())\n",
    "\n",
    "    def __call__(self, x: str) -> 'np.array':\n",
    "        tf_vector = np.zeros(len(self))\n",
    "        token_ids = self.tokenizer.encode(x).ids\n",
    "\n",
    "        for token_id in token_ids:\n",
    "            tf_vector[token_id] += 1\n",
    "\n",
    "        if len(token_ids) > 0:\n",
    "            tf_vector /= len(token_ids)\n",
    "\n",
    "        tfidf_vector = tf_vector * self.idf\n",
    "        return tfidf_vector"
   ]
