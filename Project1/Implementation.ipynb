    "from pathlib import Path\n",
    "import Project1.smlp as smlp\n",
    "import Project1.smlp2 as smlp2\n",
    "\n",
    "# Find saved checkpoints from your cross-validation\n",
    "def find_checkpoints(model_name):\n",
    "    folder = results_folder / model_name / \"seed-0\"\n",
    "\n",
    "    checkpoints = sorted(\n",
    "        path.with_suffix(\"\")\n",
    "        for path in folder.rglob(\"*.pt\")\n",
    "        if path.with_suffix(\".json\").exists()\n",
    "    )\n",
    "\n",
    "    if not checkpoints:\n",
    "        raise FileNotFoundError(\n",
    "            f\"No saved model checkpoints found in {folder}\"\n",
    "        )\n",
    "\n",
    "    return checkpoints\n",
    "\n",
    "\n",
    "mlp_checkpoints = find_checkpoints(\"mlp_indicator-enc\")\n",
    "mlp2_checkpoints = find_checkpoints(\"mlp2_indicator-enc\")\n",
    "\n",
    "print(\"Original MLP checkpoints:\")\n",
    "for i, path in enumerate(mlp_checkpoints):\n",
    "    print(i, path)\n",
    "\n",
    "print(\"\\nModified MLP checkpoints:\")\n",
    "for i, path in enumerate(mlp2_checkpoints):\n",
