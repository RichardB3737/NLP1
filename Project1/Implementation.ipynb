    "from lime.lime_text import LimeTextExplainer\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "class_names = dataset[\"train\"].features[\"label\"].names\n",
    "\n",
    "explainer = LimeTextExplainer(\n",
    "    class_names=class_names,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "models = {\n",
    "    \"Log-linear\": logistic_predict,\n",
    "    \"Original MLP\": mlp_predict,\n",
    "    \"Modified MLP\": mlp2_predict\n",
    "}\n",
    "\n",
    "tweets = [1, 2, 3]\n",
    "\n",
    "for tweet_id in tweets:\n",
    "\n",
    "    example = dataset[\"validation\"][tweet_id]\n",
    "\n",
    "    text = example[\"text\"]\n",
    "    true_label = int(example[\"label\"])\n",
    "\n",
    "    print(f\"\\n{'=' * 60}\")\n",
    "    print(f\"Tweet {tweet_id}: {text}\")\n",
    "    print(f\"True class: {class_names[true_label]}\")\n",
    "\n",
    "    for model_name, predict_fn in models.items():\n",
    "\n",
    "        probabilities = predict_fn([text])[0]\n",
    "        predicted_label = int(np.argmax(probabilities))\n",
    "\n",
    "        # Explain the same target class across all models\n",
    "        exp = explainer.explain_instance(\n",
    "            text,\n",
    "            predict_fn,\n",
    "            num_features=10,\n",
    "            num_samples=1000,\n",
    "            labels=(true_label,)\n",
    "        )\n",
    "\n",
    "        print(f\"\\n--- {model_name} ---\")\n",
    "        print(\"Prediction:\", class_names[predicted_label])\n",
    "        print(\"Probabilities:\", probabilities.round(4))\n",
    "        print(\"Explanation:\", exp.as_list(label=true_label))\n",
    "\n",
    "        fig = exp.as_pyplot_figure(label=true_label)\n",
    "        plt.title(\n",
    "            f\"{model_name} - Tweet {tweet_id}\\n\"\n",
    "            f\"Explaining: {class_names[true_label]}\"\n",
    "        )\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n"
   ]
  },
